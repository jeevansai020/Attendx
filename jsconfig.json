{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true,
    "moduleResolution": "node",
    "baseUrl": "."
  },
  "typeAcquisition": {
    "enable": true
  },
  "include": [
    "js/**/*.js",
    "js/**/*.d.ts",
    "*.html"
  ],
  "exclude": [
    "node_modules"
  ]
}
